# Web 游戏时间管理服务
#
# 必填：
#   GOSUND_PLUG_TOKEN  — 插板 token（通过 demos/xiaomi-token-by-ip.py 获取）
#   GOSUND_PLUG_IP     — 插板 IP（MAC/NAME 优先，IP 仅作回退）
#
# 浏览器访问 http://<host>:8787 进行管理。

# Web 服务
WEB_PORT=8787
WEB_HOST=0.0.0.0
WEB_STATIC_DIR=public/app
WEB_ACCESS_LOG=on
WEB_COOKIE_SECURE=false
WEB_USERS_FILE=.runtime/web-users.json

# Gosund / MiHome 插线板（cuco.plug.cp5d）
GOSUND_PLUG_MAC=
GOSUND_PLUG_NAME=power-strip
GOSUND_PLUG_IP=
GOSUND_PLUG_TOKEN=

# 游戏机 / 电视控制（复用上面同一台 GOSUND 插板）
# 游戏机接 S4，电视接 S3：玩游戏需 S3+S4 同时通电（电视当显示器），看电视只需 S3
GAME_CONSOLE_PLUG_DID=s4     # 凌晨自动充电针对的游戏机接口
GAME_PLUG_DIDS=s3,s4         # 玩游戏通电的接口集合
TV_PLUG_DIDS=s3              # 看电视通电的接口集合

# 电视安全关机：Tuya 红外 Power → 确认海信 UPnP 下线 → 延迟关闭电视插孔
TUYA_API_REGION=cn
TUYA_API_KEY=
TUYA_API_SECRET=
TUYA_IR_DEVICE_ID=
TUYA_IR_REMOTE_ID=
TUYA_IR_CATEGORY_ID=2
HISENSE_TV_MAC=
HISENSE_TV_NAME=tv
HISENSE_TV_IP=
HISENSE_TV_UPNP_PORT=38400
TV_STANDBY_TIMEOUT_SECONDS=90
TV_POWER_CUT_DELAY_SECONDS=30

# 游戏配额
GAME_DAILY_QUOTA_MINUTES=60           # 单人单日额度（分钟）
GAME_ALLOWED_WEEKDAYS=0,6             # 允许玩游戏的星期（0=周日, 6=周六）
GAME_REMINDER_SECONDS=180,60          # 到期前提醒点（秒）
GAME_MAX_SINGLE_SESSION_MINUTES=60
GAME_MIN_SINGLE_SESSION_MINUTES=5     # 单次最少 5 分钟
GAME_QUOTA_FILE=.runtime/game-quota.json
GAME_CONFIG_FILE=.runtime/game-config.json

# 凌晨自动给游戏机充电（默认开启）
AUTO_CHARGE_ENABLED=1
AUTO_CHARGE_START=03:00
AUTO_CHARGE_END=05:00
AUTO_CHARGE_STATE_FILE=.runtime/auto-charge-state.json

# Netgear/Orbi 局域网设备目录（按 MAC/名称动态解析设备 IP）
NETGEAR_ROUTER_URL=http://192.168.0.1
NETGEAR_ALLOW_INSECURE_HTTP=true
NETGEAR_ROUTER_USERNAME=
NETGEAR_ROUTER_PASSWORD=
NETGEAR_DEVICE_CACHE_SECONDS=30
NETGEAR_DEVICE_TIMEOUT_MS=10000

# 网关设备每日禁网时间管理
IPAD_ACCESS_CONFIG_FILE=.runtime/ipad-access-config.json
IPAD_ACCESS_STATE_FILE=.runtime/ipad-access-state.json